    { "when": { "support": "down", "rotation": "2", "powered": "false" }, "apply": { "model": "gt6logic:block/formula_module", "x": 90, "y": 180 } },
    { "when": { "support": "down", "rotation": "2", "powered": "true" }, "apply": { "model": "gt6logic:block/formula_module_on", "x": 90, "y": 180 } },
    { "when": { "support": "down", "rotation": "3", "powered": "false" }, "apply": { "model": "gt6logic:block/formula_module", "x": 90, "y": 270 } },
